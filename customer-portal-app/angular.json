{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "customer-portal-app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/customer-portal-app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "factory-x": {
              "optimization": false,
              "sourceMap": true,
              "index": "src/index.factory-x.html",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.factory-x.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "proxyConfig": "proxy.conf.json", "port": 4203 },
          "configurations": {
            "development": { "buildTarget": "customer-portal-app:build:development" },
            "factory-x": {
              "buildTarget": "customer-portal-app:build:factory-x",
              "port": 4204
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "c8528ef7-b453-400f-9f5f-dbd8938fbad9"
  }
}
