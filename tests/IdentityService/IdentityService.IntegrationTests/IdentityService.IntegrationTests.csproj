<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>His.Hope.IdentityService.IntegrationTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.10" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.13.0" />
    <!-- Testcontainers still declares SSH.NET 2025.1.0; pin the patched
         release so the test runner is not exposed to CVE-2026-48798. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- TestServer runs from an isolated artifacts directory; package the
         browser script explicitly instead of relying on the source checkout
         being discoverable at runtime. -->
    <Content Include="..\..\..\src\Services\IdentityService\IdentityService.Api\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Services\IdentityService\IdentityService.Api\IdentityService.Api.csproj" Aliases="global,IdentityApi" />
    <ProjectReference Include="..\IdentityService.Testing\IdentityService.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\src\Services\IdentityService\IdentityService.Api\Program.cs"
             Link="IdentityService.Program.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\Services\IdentityService\IdentityService.Api\Composition\IdentityServiceRegistrationExtensions.cs"
             Link="IdentityServiceRegistrationExtensions.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\src\Services\IdentityService\IdentityService.Api\appsettings.Production.json"
             Link="IdentityService.appsettings.Production.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
