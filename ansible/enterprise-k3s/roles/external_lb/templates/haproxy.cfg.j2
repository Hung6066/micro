global
    log /dev/log local0
    log /dev/log local1 notice
    daemon
    user haproxy
    group haproxy

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend k3s-api
    bind *:{{ lb_k3s_api_port }}
    mode tcp
    default_backend k3s-api-backend

backend k3s-api-backend
    mode tcp
    balance roundrobin
    option tcp-check
{% for backend in lb_k3s_api_backends %}
    server {{ backend.name }} {{ backend.address }}:{{ lb_k3s_api_port }} check
{% endfor %}

frontend ingress-http
    bind *:{{ lb_ingress_http_port }}
    mode tcp
    default_backend ingress-http-backend

backend ingress-http-backend
    mode tcp
    balance roundrobin
    option tcp-check
{% for backend in lb_ingress_backends %}
    server {{ backend.name }} {{ backend.address }}:{{ lb_ingress_http_node_port }} check
{% endfor %}

frontend https-sni
    # Preserve end-to-end TLS so cert-manager/Vault can rotate Harbor and the
    # Git mirror certificates without copying private keys to the load balancer.
    bind *:{{ lb_harbor_https_port }}
    mode tcp
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend git-mirror-https-backend if { req.ssl_sni -i {{ lb_git_mirror_host }} }
    default_backend harbor-https-backend

backend harbor-https-backend
    mode tcp
    balance roundrobin
    option tcp-check
    timeout server 1h
    timeout tunnel 1h
{% for backend in lb_harbor_https_backends %}
    server {{ backend.name }} {{ backend.address }}:{{ lb_harbor_https_node_port }} check
{% endfor %}

backend git-mirror-https-backend
    mode tcp
    balance roundrobin
    option tcp-check
    timeout server 1h
    timeout tunnel 1h
{% for backend in lb_git_mirror_backends %}
    server {{ backend.name }} {{ backend.address }}:{{ lb_git_mirror_https_node_port }} check
{% endfor %}
