{
  "DatabaseContinuity": {
    "Enabled": false,
    "Provider": "postgresql",
    "StorageUri": "",
    "StorageProvider": "auto",
    "StorageFallbackEnabled": true,
    "LocalStoragePath": "/var/lib/his-hope/backups",
    "EncryptionProvider": "vault-kms",
    "RetentionDays": 30,
    "KeepLastBackupsPerDatabase": 1,
    "PitrEnabled": false,
    "TargetRpoMinutes": 5,
    "TargetRtoMinutes": 30,
    "ExecutorPath": "",
    "ExecutorWorkingDirectory": "",
    "SchedulerEnabled": false,
    "BackupIntervalHours": 24,
    "RestoreDrillIntervalHours": 168,
    "RestoreDrillTargetEnvironment": "isolated",
    "VaultAddress": "",
    "VaultToken": "",
    "VaultTransitKeyName": "his-hope-backup-encryption"
  },
  "Redis": { "ConnectionString": "localhost:6379" },
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning" } } }
}
