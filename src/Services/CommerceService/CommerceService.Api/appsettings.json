{
  "AllowedHosts": "*",
  "Jwt": {
    "MetadataAddress": "http://localhost:5001/.well-known/openid-configuration",
    "Audience": "commerce-api",
    "AdditionalAudiences": [
      "His.Hope",
      "his-hope-services",
      "http://localhost:5000/"
    ],
    "AllowHttp": true
  },
  "Commerce": {
    "RateLimit": {
      "MaxRequestsPerClientTenant": 120,
      "WindowMinutes": 1
    }
  },
  "Outbox": {
    "Enabled": false
  }
}
