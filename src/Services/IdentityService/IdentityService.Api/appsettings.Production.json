{
  "ConnectionStrings": {
    "IdentityDb": "Host=cockroachdb.his-hope.svc.cluster.local;Port=26257;Database=identitydb;Username=identity_svc;Password="
  },
  "Jwt": {
    "Issuer": "His.Hope.IdentityService",
    "Audience": "His.Hope",
    "RsaEncryptionPrivateKeyPath": "/etc/hishop/certs/oidc-encryption-private-key.pem",
    "RsaEncryptionKeyId": "oidc-encryption-v1"
  },
  "OpenIddict": {
    "Issuer": "https://identity.his-hope.vn",
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "AuthorizationCodeLifetime": "00:01:00",
    "RequirePkce": true,
    "AllowInsecureHttp": false,
    "Signing": {
      "PrivateKeyPath": "/etc/hishop/certs/jwt-private-key.pem",
      "KeyId": "jwt-signing-v1"
    },
    "Encryption": {
      "PrivateKeyPath": "/etc/hishop/certs/oidc-encryption-private-key.pem",
      "KeyId": "oidc-encryption-v1"
    }
  },
  "Dpop": {
    "RequiredClientIds": [ "his-hope-mobile" ]
  },
  "Passkeys": {
    "RpId": "his-hope.vn",
    "RpName": "His.Hope",
    "Origins": [
      "https://his-hope.vn",
      "https://dashboard.his-hope.vn",
      "https://admin.his-hope.vn"
    ]
  },
  "Saml2": {
    "Enabled": true,
    "Issuer": "https://identity.his-hope.vn/saml",
    "IdPMetadata": "${SAML_IDP_METADATA}",
    "DetectReplayedTokens": true,
    "AudienceRestricted": true
  },
  "Ldap": {
    "Enabled": true,
    "Server": "${LDAP_SERVER}",
    "Port": 636,
    "UseSsl": true,
    "RequireStartTls": false,
    "BindDn": "${LDAP_BIND_DN}",
    "BindPassword": "${LDAP_BIND_PASSWORD}",
    "SearchBase": "${LDAP_SEARCH_BASE}",
    "SearchFilter": "(&(objectClass=user)(objectCategory=person))",
    "SyncIntervalMinutes": 15
  },
  "PushProviders": {
    "RequireProductionCredentials": true,
    "ApnsEnabled": true,
    "FirebaseCredentialsFile": "${FIREBASE_CREDENTIALS_FILE}",
    "FirebaseCredentialsJson": "${FIREBASE_CREDENTIALS_JSON}",
    "ApnsKeyId": "${APNS_KEY_ID}",
    "ApnsTeamId": "${APNS_TEAM_ID}",
    "ApnsPrivateKey": "${APNS_PRIVATE_KEY}",
    "ApnsBundleId": "${APNS_BUNDLE_ID}",
    "ApnsEndpoint": "${APNS_ENDPOINT:-https://api.push.apple.com}"
  },
  "Vault": {
    "Address": "https://vault.his-hope.svc.cluster.local:8200",
    "AuthMethod": "kubernetes",
    "AuthMount": "kubernetes",
    "JwtTokenFile": "/var/run/secrets/tokens/vault",
    "AllowStaticToken": false,
    "EnableTransit": true,
    "RequireVault": true,
    "SecretsMount": "secret",
    "SecretsPathPrefix": "his-hope/identity/client-secrets",
    "Transit": {
      "KeyName": "jwt-signing",
      "MfaKeyName": "mfa-secret",
      "MountPoint": "transit"
    }
  },
  "Vault:Database": {
    "Enabled": true,
    "Role": "identity-service-db",
    "MinimumLeaseSeconds": 900
  },
  "Database": {
    "ConnectionLifetimeSeconds": 60,
    "ConnectionIdleLifetimeSeconds": 30
  },
  "Redis": {
    "ConnectionString": "redis.his-hope.svc.cluster.local:6379,ssl=true,password=${REDIS_PASSWORD}"
  },
  "DataProtection": {
    "KeyName": "HisHope:IdentityService:DataProtection:Keys"
  },
  "Authentication": {
    "CookieDomain": ".his-hope.vn",
    "RedirectWhitelist": [
      "https://his-hope.vn",
      "https://dashboard.his-hope.vn",
      "https://admin.his-hope.vn"
    ],
    "OidcClients": {
      "his-hope-spa": {
        "RedirectUris": [
          "https://his-hope.vn/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://his-hope.vn/auth/login"
        ]
      },
      "his-hope-dashboard": {
        "RedirectUris": [
          "https://dashboard.his-hope.vn/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://dashboard.his-hope.vn/auth/login"
        ]
      },
      "his-hope-admin": {
        "RedirectUris": [
          "https://admin.his-hope.vn/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://admin.his-hope.vn/auth/login"
        ]
      },
      "his-hope-mobile": {
        "RedirectUris": [
          "https://mobile.his-hope.example/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://mobile.his-hope.example/auth/logout-callback"
        ]
      }
    },
    "Google": {
      "ClientId": "${GOOGLE_CLIENT_ID}",
      "ClientSecret": "${GOOGLE_CLIENT_SECRET}"
    },
    "Microsoft": {
      "ClientId": "${MS_CLIENT_ID}",
      "ClientSecret": "${MS_CLIENT_SECRET}"
    },
    "Entra": {
      "Authority": "${ENTRA_AUTHORITY}",
      "ClientId": "${ENTRA_CLIENT_ID}",
      "ClientSecret": "${ENTRA_CLIENT_SECRET}"
    },
    "ExternalSources": []
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.his-hope.vn",
      "https://dashboard.his-hope.vn",
      "https://admin.his-hope.vn"
    ]
  },
  "RateLimiting": {
    "TrustForwardedKey": false,
    "MaxRequestsPerIp": 1000,
    "MaxRequestsPerUser": 2000,
    "WindowMinutes": 1,
    "Mfa": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Scim": { "PermitLimit": 60, "WindowSeconds": 60 },
    "ExternalLogin": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "Scim": {
    "RequireFacilityScope": true
  },
  "Security": {
    "PasswordMaxAgeDays": 90,
    "RequireMfa": true
  },
  "SecuritySignals": {
    "Subscriptions": []
  },
  "Mtls": {
    "TrustedCaFile": "/etc/hishop/certs/client-ca.pem"
  },
  "Provisioning": {
    "Scim": { "BaseUrl": "", "TokenUrl": "", "ClientId": "", "Scope": "scim.write" },
    "Entra": { "Enabled": false, "BaseUrl": "https://graph.microsoft.com/v1.0", "TokenUrl": "", "ClientId": "", "Scope": "https://graph.microsoft.com/.default" },
    "GoogleWorkspace": { "Enabled": false, "BaseUrl": "https://admin.googleapis.com/admin/directory/v1", "TokenUrl": "https://oauth2.googleapis.com/token", "ServiceAccountSecretId": "google-workspace-service-account", "DelegatedAdmin": "" }
  },
  "Radius": {
    "EapTls": { "Enabled": false }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "His.Hope": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://elasticsearch:9200",
          "indexFormat": "his-hope-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "batchPostingLimit": 50,
          "inlineFields": true
        }
      }
    ],
    "Enrich": [
      { "Name": "WithProperty", "Args": { "name": "service", "value": "identity-service" } }
    ]
  },
  "AllowedHosts": "identity.his-hope.vn;identity.his-hope.svc.cluster.local"
}
