{
  "Conglomerate": {
    "Enabled": true,
    "SkipDemoHospitalScope": true,
    "SeedPilotMemberships": true,
    "SeedPilotUsers": true,
    "SeedDataPath": "config/conglomerate/seed-data.v1.json",
    "PilotUserPassword": "${CONGLOMERATE_PILOT_PASSWORD}",
    "IamScopesPath": "config/conglomerate/iam-scopes.v1.json",
    "OidcClientsPath": "config/conglomerate/oidc-clients.azure-staging.json",
    "CustomerTenantsPath": "config/conglomerate/customer-tenants.v1.json",
    "HqCustomerVisibility": "all",
    "Organization": {
      "Key": "abc-group",
      "DisplayName": "ABC Group"
    },
    "Tenants": [
      { "Key": "manufacturing", "DisplayName": "Manufacturing Co", "TenantClass": "internal" },
      { "Key": "tech-vendor", "DisplayName": "Technology Co", "TenantClass": "internal" },
      { "Key": "group-hq", "DisplayName": "Group HQ", "TenantClass": "internal" },
      {
        "Key": "customer-acme",
        "DisplayName": "Acme Healthcare",
        "TenantClass": "customer",
        "OperatorHome": "tech-vendor",
        "AccountKey": "customer-acme-account",
        "AccountDisplayName": "Acme production account",
        "EnvironmentKey": "staging",
        "EnvironmentDisplayName": "Azure staging"
      },
      {
        "Key": "customer-factory-x",
        "DisplayName": "Factory X Industrial",
        "TenantClass": "customer",
        "OperatorHome": "manufacturing",
        "AccountKey": "customer-factory-x-account",
        "AccountDisplayName": "Factory X production account",
        "EnvironmentKey": "customer-factory-x-staging",
        "EnvironmentDisplayName": "Azure staging"
      }
    ],
    "OidcClientTenants": {
      "his-hope-dashboard": "group-hq",
      "his-hope-spa": "group-hq",
      "his-hope-mobile": "group-hq",
      "his-hope-operator-mobile": "manufacturing",
      "manufacturing-app": "manufacturing",
      "tech-console": "tech-vendor",
      "group-hq-admin": "group-hq",
      "customer-acme-portal": "customer-acme",
      "customer-acme-app": "customer-acme",
      "customer-factory-x-portal": "customer-factory-x",
      "customer-factory-x-app": "customer-factory-x"
    },
    "OidcClientPortalClasses": {
      "manufacturing-app": "operator",
      "tech-console": "operator",
      "group-hq-admin": "operator",
      "his-hope-admin": "operator",
      "his-hope-dashboard": "operator",
      "his-hope-spa": "operator",
      "his-hope-mobile": "operator",
      "his-hope-operator-mobile": "operator",
      "customer-acme-portal": "customer_operator",
      "customer-acme-app": "end_user",
      "customer-factory-x-portal": "customer_operator",
      "customer-factory-x-app": "end_user"
    },
    "OidcClientDisplayNames": {
      "his-hope-admin": "His Hope Admin",
      "his-hope-dashboard": "His Hope Dashboard",
      "his-hope-spa": "His Hope SPA",
      "his-hope-mobile": "His Hope Mobile",
      "his-hope-operator-mobile": "His Hope Operator Mobile",
      "manufacturing-app": "Manufacturing Portal",
      "tech-console": "Tech Vendor Console",
      "group-hq-admin": "Group HQ Admin",
      "customer-acme-portal": "Acme Admin Portal",
      "customer-acme-app": "Acme Clinical App",
      "customer-factory-x-portal": "Factory X Admin Portal",
      "customer-factory-x-app": "Factory X Operations App"
    },
    "CrossTenantPolicy": {
      "DefaultDeny": true,
      "AllowedPairs": [
        {
          "Source": "group-hq",
          "Target": "manufacturing",
          "Reason": "group-audit-read",
          "Permissions": ["admin.audit.read"]
        },
        {
          "Source": "group-hq",
          "Target": "tech-vendor",
          "Reason": "group-audit-read",
          "Permissions": ["admin.audit.read"]
        }
      ]
    }
  },
  "ConnectionStrings": {
    "IdentityDb": "Host=${DATABASE_POSTGRES_HOST};Port=5432;Database=identitydb;Username=${DATABASE_POSTGRES_USER};Password=${SECRET_POSTGRES_PASSWORD};Ssl Mode=Require;Trust Server Certificate=true"
  },
  "OpenIddict": {
    "Issuer": "https://identity.staging.abc-group.example"
  },
  "Jwt": {
    "Issuer": "His.Hope.IdentityService",
    "Audience": "His.Hope"
  },
  "Dpop": {
    "RequiredClientIds": [ "his-hope-mobile", "his-hope-operator-mobile", "his-hope-admin" ]
  },
  "Passkeys": {
    "RpId": "staging.abc-group.example",
    "RpName": "ABC Group Identity",
    "Origins": [
      "https://manufacturing.staging.abc-group.example",
      "https://tech.staging.abc-group.example",
      "https://admin.staging.abc-group.example",
      "https://acme.staging.abc-group.example",
      "http://localhost:4203",
      "https://factory-x.staging.abc-group.example",
      "http://localhost:4204",
      "http://localhost:4205"
    ]
  },
  "Authentication": {
    "CookieDomain": ".staging.abc-group.example",
    "RedirectWhitelist": [
      "https://manufacturing.staging.abc-group.example",
      "https://tech.staging.abc-group.example",
      "https://admin.staging.abc-group.example",
      "https://acme.staging.abc-group.example",
      "https://acme-app.staging.abc-group.example",
      "http://localhost:4203",
      "https://factory-x.staging.abc-group.example",
      "https://factory-x-app.staging.abc-group.example",
      "http://localhost:4204",
      "https://ops.staging.abc-group.example"
    ],
    "OidcClients": {
      "his-hope-spa": {
        "RedirectUris": [
          "https://manufacturing.staging.abc-group.example/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://manufacturing.staging.abc-group.example/auth/login"
        ]
      },
      "his-hope-admin": {
        "RedirectUris": [
          "https://admin.staging.abc-group.example/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://admin.staging.abc-group.example/auth/login"
        ]
      },
      "his-hope-dashboard": {
        "RedirectUris": [
          "https://ops.staging.abc-group.example/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://ops.staging.abc-group.example/auth/login"
        ]
      },
      "his-hope-mobile": {
        "RedirectUris": [
          "hishope://auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "hishope://auth/logout-callback"
        ]
      },
      "his-hope-operator-mobile": {
        "RedirectUris": [
          "hishope://auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "hishope://auth/logout-callback"
        ]
      },
      "manufacturing-app": {
        "RedirectUris": [
          "https://manufacturing.staging.abc-group.example/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://manufacturing.staging.abc-group.example/auth/login"
        ]
      },
      "tech-console": {
        "RedirectUris": [
          "https://tech.staging.abc-group.example/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://tech.staging.abc-group.example/auth/login"
        ]
      },
      "group-hq-admin": {
        "RedirectUris": [
          "https://admin.staging.abc-group.example/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://admin.staging.abc-group.example/auth/login"
        ]
      },
      "customer-acme-portal": {
        "RedirectUris": [
          "https://acme.staging.abc-group.example/auth/callback",
          "http://localhost:4203/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://acme.staging.abc-group.example/auth/login",
          "http://localhost:4203/auth/login"
        ]
      },
      "customer-acme-app": {
        "RedirectUris": [
          "https://acme-app.staging.abc-group.example/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://acme-app.staging.abc-group.example/auth/login"
        ]
      },
      "customer-factory-x-portal": {
        "RedirectUris": [
          "https://factory-x.staging.abc-group.example/auth/callback",
          "http://localhost:4204/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://factory-x.staging.abc-group.example/auth/login",
          "http://localhost:4204/auth/login"
        ]
      },
      "customer-factory-x-app": {
        "RedirectUris": [
          "https://factory-x-app.staging.abc-group.example/auth/callback",
          "http://localhost:4205/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://factory-x-app.staging.abc-group.example/auth/login",
          "http://localhost:4205/auth/login"
        ]
      }
    }
  },
  "Assurance": {
    "PolicyPath": "config/assurance-policy.v1.json"
  },
  "Persistence": {
    "RunMigrationsOnStartup": true
  },
  "Vault": {
    "Address": "",
    "EnableTransit": false
  },
  "DataProtection": {
    "KeyName": "HisHope:IdentityService:AzureStaging:DataProtection:Keys"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
