{
  "Passkeys": {
    "RpId": "localhost",
    "RpName": "His.Hope",
    "Origins": [ "http://localhost:5000", "http://localhost:8081", "http://localhost:8082", "http://localhost:8083", "https://localhost" ]
  },
  "Saml2": {
    "Enabled": false,
    "Issuer": "https://identity.his-hope.vn/saml",
    "SingleSignOnDestination": "",
    "AllowedIssuer": "",
    "IdPMetadata": "",
    "DetectReplayedTokens": true,
    "AudienceRestricted": true
  },
  "Authentication": {
    "ExternalSources": []
  },
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5433;Database=identitydb;Username=postgres;Password=${DB_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "His.Hope.IdentityService",
    "Audience": "His.Hope",
    "Key": "${JWT_SIGNING_KEY}",
    "RsaPublicKeyPath": "${JWT_RSA_PUBLIC_KEY_PATH:-Certificates/jwt-public-key.pem}",
    "RsaPrivateKeyPath": "${JWT_RSA_PRIVATE_KEY_PATH:-Certificates/jwt-private-key.pem}",
    "RsaEncryptionPrivateKeyPath": "${JWT_RSA_ENCRYPTION_PRIVATE_KEY_PATH:-Certificates/jwt-encryption-private-key.pem}",
    "RsaEncryptionKeyId": "oidc-encryption-v1"
  },
  "OpenIddict": {
    "Issuer": "https://identity.his-hope.local",
    "DynamicRegistrationToken": "${OIDC_DYNAMIC_REGISTRATION_TOKEN}",
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "AuthorizationCodeLifetime": "00:01:00",
    "RequirePkce": true,
    "Encryption": {
      "PrivateKeyPath": "${JWT_RSA_ENCRYPTION_PRIVATE_KEY_PATH:-Certificates/jwt-encryption-private-key.pem}",
      "KeyId": "oidc-encryption-v1"
    }
  },
  "Dpop": {
    "RequiredClientIds": [ "his-hope-mobile" ]
  },
  "Vault": {
    "Address": "http://vault.his-hope.svc.cluster.local:8200",
    "EnableTransit": false,
    "RoleId": "",
    "SecretId": "",
    "Transit": {
      "KeyName": "jwt-signing",
      "MountPoint": "transit"
    }
  },
  "DataProtection": {
    "KeyName": "HisHope:IdentityService:DataProtection:Keys"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://elasticsearch:9200",
          "username": "${ES_LOG_USER}",
          "password": "${ES_LOG_PASSWORD}",
          "indexFormat": "his-hope-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "typeName": "logevent",
          "batchPostingLimit": 50,
          "inlineFields": true
        }
      }
    ],
    "Enrich": [
      { "Name": "WithProperty", "Args": { "name": "service", "value": "identity-service" } }
    ]
  },
  "Authentication": {
    "CookieDomain": "",
    "RedirectWhitelist": [
      "https://his-hope.vn",
      "https://dashboard.his-hope.vn",
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:4202",
      "http://localhost:4203",
      "http://localhost:4204",
      "http://localhost:4205"
    ],
    "OidcClients": {
      "his-hope-spa": {
        "RedirectUris": [
          "http://localhost:4200/auth/callback",
          "http://localhost:8081/auth/callback",
          "https://his-hope.local/api/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:4200/auth/login",
          "http://localhost:8081/auth/login",
          "https://his-hope.local"
        ]
      },
      "his-hope-dashboard": {
        "RedirectUris": [
          "http://localhost:4201/auth/callback",
          "http://localhost:8082/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:4201/auth/login",
          "http://localhost:8082/auth/login"
        ]
      },
      "his-hope-admin": {
        "RedirectUris": [
          "http://localhost:8083/auth/callback",
          "http://localhost:4202/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:8083/auth/login",
          "http://localhost:4202/auth/login"
        ]
      },
      "his-hope-mobile": {
        "RedirectUris": [
          "hishope://auth/callback",
          "http://localhost:4300/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "hishope://auth/logout-callback",
          "http://localhost:4300/auth/logout-callback"
        ]
      },
      "customer-acme-portal": {
        "RedirectUris": [
          "http://localhost:4203/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:4203/auth/login"
        ]
      },
      "customer-factory-x-portal": {
        "RedirectUris": [
          "http://localhost:4204/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:4204/auth/login"
        ]
      },
      "customer-factory-x-app": {
        "RedirectUris": [
          "http://localhost:4205/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:4205/auth/login"
        ]
      }
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Ldap": {
    "Enabled": false,
    "Server": "ldap.his-hope.local",
    "Port": 389,
    "UseSsl": false,
    "BindDn": "CN=svc_hishop,CN=Users,DC=his-hope,DC=local",
    "BindPassword": "",
    "SearchBase": "OU=Hospital Users,DC=his-hope,DC=local",
    "SearchFilter": "(&(objectClass=user)(objectCategory=person))",
    "UserNameAttribute": "sAMAccountName",
    "EmailAttribute": "mail",
    "FirstNameAttribute": "givenName",
    "LastNameAttribute": "sn",
    "SyncIntervalMinutes": 15,
    "GroupRoleMapping": {
      "CN=Doctors": "Provider",
      "CN=Nurses": "Nurse",
      "CN=LabStaff": "LabTechnician",
      "CN=PharmacyStaff": "Pharmacist",
      "CN=AdminStaff": "Admin",
      "CN=ReceptionStaff": "Receptionist",
      "CN=BillingStaff": "BillingClerk"
    }
  },
  "Email": {
    "From": "noreply@his-hope.vn",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "EnableSsl": false
  },
  "RateLimiting": {
    "MaxRequestsPerIp": 1000,
    "MaxRequestsPerUser": 2000,
    "WindowMinutes": 1,
    "TrustForwardedKey": false
  },
  "AllowedHosts": "*"
}
