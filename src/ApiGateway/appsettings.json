{
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [{ "Name": "Console" }]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "identity-localization": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/localization" }
      },
      "saml-federation": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/federation/saml/{**catch-all}" }
      },
      "mobile-platform": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/mobile/{**catch-all}" }
      },
      "patient-encounters": {
        "ClusterId": "clinical",
        "Match": { "Path": "/api/v1/patients/{patientId}/encounters" }
      },
      "patient-appointments": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/v1/patients/{patientId}/appointments" }
      },
      "patient-lab-orders": {
        "ClusterId": "lab",
        "Match": { "Path": "/api/v1/patients/{patientId}/lab-orders" }
      },
      "lab-orders": {
        "ClusterId": "lab",
        "Match": { "Path": "/api/v1/lab-orders/{**catch-all}" }
      },
      "patient-prescriptions": {
        "ClusterId": "pharmacy",
        "Match": { "Path": "/api/v1/patients/{patientId}/prescriptions" }
      },
      "patient-invoices": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/v1/patients/{patientId}/invoices" }
      },
      "lab-critical-alerts-hub-root": {
        "ClusterId": "lab",
        "Match": { "Path": "/hubs/lab-critical-alerts" }
      },
      "lab-critical-alerts-hub": {
        "ClusterId": "lab",
        "Match": { "Path": "/hubs/lab-critical-alerts/{**catch-all}" }
      },
      "appointments": {
        "ClusterId": "appointments",
        "Match": { "Path": "/api/v1/appointments/{**catch-all}" }
      },
      "lab-critical-alerts": {
        "ClusterId": "lab",
        "Match": { "Path": "/api/v1/critical-alerts/{**catch-all}" }
      },
      "lab-critical-alert-rules": {
        "ClusterId": "lab",
        "Match": { "Path": "/api/v1/critical-alert-rules/{**catch-all}" }
      },
      "pharmacy-prescriptions": {
        "ClusterId": "pharmacy",
        "Match": { "Path": "/api/v1/prescriptions/{**catch-all}" }
      },
      "lab-bff": {
        "ClusterId": "lab-bff",
        "Match": { "Path": "/api/v1/bff/lab/{**catch-all}" }
      },
      "billing-bff": {
        "ClusterId": "billing-bff",
        "Match": { "Path": "/api/v1/bff/billing/{**catch-all}" }
      },
      "dashboard-bff": {
        "ClusterId": "dashboard-bff",
        "Match": { "Path": "/api/v1/bff/dashboard/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/bff/dashboard" }
        ]
      },
      "systemdashboard-bff": {
        "ClusterId": "systemdashboard-bff",
        "Match": { "Path": "/api/v1/bff/system-dashboard/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/bff/system-dashboard" }
        ]
      },
      "admin": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/admin/{**catch-all}" }
      },
      "database-continuity": {
        "ClusterId": "database-continuity",
        "Order": -1,
        "Match": { "Path": "/api/v1/admin/database-continuity/{**catch-all}" }
      },
      "settings": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/settings/{**catch-all}" }
      },
      "audit-logs": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/audit-logs/{**catch-all}" }
      },
      "audit-events": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/audit/{**catch-all}" }
      },
      "dashboard": {
        "ClusterId": "dashboard-bff",
        "Match": { "Path": "/api/v1/dashboard/{**catch-all}" }
      },
      "errors": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/errors/{**catch-all}" }
      },
      "oidc-connect": {
        "ClusterId": "identity",
        "Match": { "Path": "/connect/{**catch-all}" }
      },
      "oidc-discovery": {
        "ClusterId": "identity",
        "Match": { "Path": "/.well-known/{**catch-all}" }
      },
      "oidc-account": {
        "ClusterId": "identity",
        "Match": { "Path": "/Account/{**catch-all}" }
      }
    },
    "Clusters": {}
  },
  "CORS": {
    "AllowedOrigins": "http://localhost,http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4204,http://localhost:4205,http://localhost:4300,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://frontend:8080,https://app.his-hope.internal,https://localhost,capacitor://localhost"
  },
  "Certificates": {
    "Path": "",
    "Password": ""
  },
  "RateLimiting": {
    "MaxRequestsPerIp": 1000,
    "MaxRequestsPerUser": 2000,
    "WindowMinutes": 1
  },
  "ConnectionStrings": {
    "IdempotencyDb": "Host=localhost;Port=26257;Database=his_hope_idempotency;Username=root;Password=;"
  }
}
