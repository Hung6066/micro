<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>His.Hope.Resilience</RootNamespace>
    <AssemblyName>His.Hope.Resilience</AssemblyName>
    <PackageId>His.Hope.Resilience</PackageId>
    <Version>1.0.0</Version>
    <Description>Shared Polly resilience pipelines for His.Hope HTTP and gRPC clients.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.7.0" />
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
