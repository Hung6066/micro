{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": "Development",
  "Consul": {
    "Address": "http://localhost:8500"
  },
  "Elasticsearch": {
    "LogIndex": "his-hope-logs-*"
  },
  "Loki": {
    "Url": "http://localhost:3100",
    "DefaultQuery": "{job=\"kubernetes-pods\",filename=~\"/var/log/pods/his-hope-dev_.*\"}"
  },
  "Jaeger": {
    "QueryUrl": "http://localhost:16686"
  },
  "Prometheus": {},
  "Docker": {
    "Enabled": false,
    "ComposeProjectName": "his-hope"
  },
  "Kubernetes": {
    "Enabled": false
  },
  "Jwt": {
    "Authority": "http://identityservice:5001",
    "Issuer": "His.Hope.IdentityService",
    "Audience": "His.Hope"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "http://localhost:8082"
    ]
  },
  "RateLimiting": {
    "MaxRequestsPerIp": 100,
    "MaxRequestsPerUser": 200,
    "WindowSeconds": 60
  }
}
