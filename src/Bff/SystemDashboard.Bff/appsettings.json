{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": "Development",
  "Consul": {
    "Address": "http://localhost:8500"
  },
  "Elasticsearch": {
    "LogIndex": "his-hope-logs-*"
  },
  "Loki": {
    "Url": "http://localhost:3100",
    "DefaultQuery": "{job=\"kubernetes-pods\",filename=~\"/var/log/pods/his-hope-dev_.*\"}"
  },
  "Jaeger": {
    "QueryUrl": "http://localhost:16686"
  },
  "Prometheus": {},
  "Docker": {
    "Enabled": false,
    "ComposeProjectName": "his-hope"
  },
  "Kubernetes": {
    "Enabled": false
  },
  "Jwt": {
    "Authority": "http://identityservice:5001",
    "Issuer": "His.Hope.IdentityService",
    "Audience": "His.Hope"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "http://localhost:8082"
    ]
  },
  "RateLimiting": {
    "MaxRequestsPerIp": 100,
    "MaxRequestsPerUser": 200,
    "WindowSeconds": 60
  },
  "Plugins": {
    "Items": [
      { "Key": "manufacturing", "DisplayName": "Manufacturing", "Enabled": true, "DashboardRoute": "/manufacturing", "Icon": "factory", "Permissions": ["manufacturing.view"] },
      { "Key": "commerce", "DisplayName": "Commerce", "Enabled": true, "DashboardRoute": "/commerce", "Icon": "shopping_cart", "Permissions": ["commerce.view"] },
      { "Key": "content", "DisplayName": "Content", "Enabled": true, "DashboardRoute": "/content", "Icon": "article", "Permissions": ["content.view"] },
      { "Key": "patient", "DisplayName": "Patient", "Enabled": true, "DashboardRoute": "/patient", "Icon": "person", "Permissions": ["patients.view"] },
      { "Key": "appointment", "DisplayName": "Appointment", "Enabled": true, "DashboardRoute": "/appointments", "Icon": "event", "Permissions": ["appointments.view"] },
      { "Key": "clinical", "DisplayName": "Clinical", "Enabled": true, "DashboardRoute": "/clinical", "Icon": "medical_services", "Permissions": ["clinical.view"] },
      { "Key": "lab", "DisplayName": "Lab", "Enabled": true, "DashboardRoute": "/lab", "Icon": "science", "Permissions": ["lab.view"] },
      { "Key": "billing", "DisplayName": "Billing", "Enabled": true, "DashboardRoute": "/billing", "Icon": "receipt_long", "Permissions": ["billing.view"] },
      { "Key": "pharmacy", "DisplayName": "Pharmacy", "Enabled": true, "DashboardRoute": "/pharmacy", "Icon": "medication", "Permissions": ["pharmacy.view"] }
    ]
  }
}
