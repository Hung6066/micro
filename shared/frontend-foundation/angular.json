{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "frontend-foundation": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/storybook-host",
            "index": "src/storybook-index.html",
            "browser": "src/storybook-main.ts",
            "tsConfig": "tsconfig.storybook.json",
            "styles": ["src/styles/_foundation.scss"]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": { "browserTarget": "frontend-foundation:build", "port": 6006 }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": { "browserTarget": "frontend-foundation:build", "outputDir": "storybook-static" }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "include": ["src/**/*.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {}
        }
      }
    }
  }
}
