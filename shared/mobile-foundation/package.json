{
  "name": "@his-hope/mobile-foundation",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Platform contracts and reusable Angular shell for His.Hope Capacitor applications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/angular/types/his-hope-mobile-foundation-angular.d.ts",
      "default": "./dist/angular/fesm2022/his-hope-mobile-foundation-angular.mjs"
    }
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@his-hope/frontend-foundation": "^1.1.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": { "optional": true },
    "@angular/core": { "optional": true },
    "@angular/forms": { "optional": true },
    "@angular/router": { "optional": true },
    "@his-hope/frontend-foundation": { "optional": true },
    "rxjs": { "optional": true }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm --prefix ../frontend-foundation run build && ng-packagr -p angular/ng-package.json",
    "build:contracts": "tsc -p tsconfig.json",
    "build:angular": "ng-packagr -p angular/ng-package.json",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && node scripts/write-test-dist-package.cjs && node scripts/run-test-dist.cjs",
    "lint": "eslint ."
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "devDependencies": {
    "@angular/common": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@his-hope/frontend-foundation": "file:../frontend-foundation",
    "eslint": "^9.17.0",
    "ng-packagr": "^21.2.0",
    "rxjs": "^7.8.1",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
