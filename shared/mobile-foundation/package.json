{
  "name": "@his-hope/mobile-foundation",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Platform contracts shared by His.Hope Capacitor applications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && node scripts/write-test-dist-package.cjs && node --test \"test-dist/**/*.spec.js\"",
    "lint": "eslint ."
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
