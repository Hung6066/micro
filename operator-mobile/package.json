{
  "name": "@his-hope/operator-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm --prefix ../shared/frontend-foundation run build && npm --prefix ../shared/mobile-foundation run build",
    "prestart": "node -e \"try { require('fs').rmSync('.angular/cache',{recursive:true,force:true,maxRetries:3,retryDelay:100}); } catch (error) { if (!['EPERM','EBUSY'].includes(error.code)) throw error; }\"",
    "start": "ng serve --port 4310",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/router": "21.2.19",
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/material-symbols-rounded": "^5.3.1",
    "@his-hope/frontend-foundation": "file:../shared/frontend-foundation",
    "@his-hope/mobile-foundation": "file:../shared/mobile-foundation",
    "@sentry/angular": "^10.68.0",
    "@types/qrcode": "^1.5.6",
    "angular-auth-oidc-client": "^19.0.2",
    "capacitor-native-biometric": "^4.2.2",
    "material-icons": "^1.13.14",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.20",
    "@angular-eslint/builder": "^21.0.0",
    "@angular/cli": "21.2.20",
    "@angular/compiler-cli": "21.2.19",
    "@capacitor/cli": "^7.4.4",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.17.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0"
  }
}
