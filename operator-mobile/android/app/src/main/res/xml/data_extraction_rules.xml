<?xml version="1.0" encoding="utf-8"?>
<!-- Operator sessions and offline commands must never leave the device via
     cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
