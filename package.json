{
  "name": "his-hope-frontend-workspace",
  "private": true,
  "workspaces": [
    "shared/frontend-foundation",
    "shared/mobile-foundation",
    "admin-app",
    "customer-portal-app",
    "internal-operator-app",
    "manufacturing-buyer-app",
    "dashboard-app",
    "operator-mobile",
    "src/Frontend/his-hope-app",
    "mobile-app"
  ],
  "scripts": {
    "build:shared": "npm --workspace @his-hope/frontend-foundation run build",
    "build:shared:locked": "node scripts/build-shared-foundation-locked.mjs",
    "build:mobile-foundation": "npm --workspace @his-hope/mobile-foundation run build",
    "build:shared:all": "npm run build:shared && npm run build:mobile-foundation",
    "build:admin:production": "npm run build:shared:locked && npm --workspace admin-app run build -- --configuration production",
    "build:operator:production": "npm run build:shared:locked && npm --workspace internal-operator-app run build -- --configuration production",
    "build:buyer:production": "npm run build:shared:locked && npm --workspace manufacturing-buyer-app run build -- --configuration production",
    "storybook": "npm --workspace @his-hope/frontend-foundation run storybook",
    "storybook:build": "npm --workspace @his-hope/frontend-foundation run build-storybook",
    "test:visual": "npm --prefix tests/e2e run test:shared-foundation",
    "test:a11y": "npm --prefix tests/e2e run test:shared-foundation",
    "validate:foundation": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validate-shared-foundation.ps1",
    "validate:shared-packages": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validate-shared-package-governance.ps1",
    "audit:admin-ui": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/audit-admin-ui-actions.ps1",
    "audit:i18n-keys": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/audit-i18n-keys.ps1 -FailOnMissing",
    "lint:design-tokens": "node scripts/validate-design-tokens.mjs",
    "lint:hardcoded-px": "node scripts/validate-no-hardcoded-px.mjs",
    "validate:i18n": "node scripts/validate-i18n-boundary.mjs",
    "validate:identity-migrations": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validate-identity-migration-safety.ps1",
    "inspect:identity-scale": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/inspect-identity-scale-readiness.ps1",
    "validate:identity-migration-dry-run": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validate-identity-migration-dry-run.ps1",
    "policy:gate": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify-his-hope-policy.ps1 -Ci",
    "validate:mobile-release": "node scripts/validate-mobile-release.mjs",
    "prepare:mobile-release": "node scripts/prepare-mobile-release.mjs",
    "inject:mobile-cert-pins": "node scripts/inject-mobile-cert-pins.mjs",
    "hooks:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-git-hooks.ps1",
    "lint:foundation": "npm --workspace @his-hope/frontend-foundation run lint",
    "lint:mobile-foundation": "npm --workspace @his-hope/mobile-foundation run lint",
    "lint:admin": "npm --workspace admin-app run lint",
    "lint:dashboard": "npm --workspace dashboard-app run lint",
    "lint:clinical": "npm --workspace his-hope-app run lint",
    "lint:mobile": "npm --workspace @his-hope/mobile-app run lint",
    "lint:operator-mobile": "npm --workspace @his-hope/operator-mobile run lint",
    "lint:operator": "npm --workspace internal-operator-app run lint",
    "lint": "npm run lint:foundation && npm run lint:mobile-foundation && npm run lint:admin && npm run lint:dashboard && npm run lint:clinical && npm run lint:mobile && npm run lint:operator-mobile && npm run lint:operator",
    "test:mobile-foundation": "npm --workspace @his-hope/mobile-foundation run test",
    "test:mobile": "npm --workspace @his-hope/mobile-app run test -- --browsers=ChromeHeadless --watch=false",
    "test:operator-mobile": "npm --workspace @his-hope/operator-mobile run test -- --browsers=ChromeHeadless --watch=false",
    "test:e2e": "npm --prefix tests/e2e run test",
    "test:e2e:security": "npm --prefix tests/e2e run test:security"
  },
  "devDependencies": {
    "@angular/localize": "^21.2.19"
  }
}
