HIS_HOPE_ENVIRONMENT=staging
HIS_HOPE_RUNTIME_CONTRACT_VERSION=v1
HIS_HOPE_PUBLIC_API_ORIGIN=https://api.staging.his-hope.example
HIS_HOPE_PUBLIC_WEB_ORIGIN=https://app.staging.his-hope.example
HIS_HOPE_PUBLIC_ADMIN_ORIGIN=https://admin.staging.his-hope.example
HIS_HOPE_PUBLIC_DASHBOARD_ORIGIN=https://ops.staging.his-hope.example
HIS_HOPE_OIDC_AUTHORITY=https://identity.staging.his-hope.example
HIS_HOPE_SECRET_PROVIDER=vault
HIS_HOPE_SECRET_PROVIDER_REF=kv/data/his-hope/staging/runtime
IDENTITY_BOOTSTRAP_ADMIN_RESET_PASSWORD=false
# Configure one or more platform super-admin IDs through the secret/config overlay:
# Identity__SuperAdmin__UserIds__0=<confirmed-admin-user-guid>
SERVICE_API_GATEWAY_URL=http://gateway.internal.staging.his-hope.example:5000
SERVICE_IDENTITY_URL=http://identity.internal.staging.his-hope.example:5001
SERVICE_PATIENT_URL=http://patient.internal.staging.his-hope.example:5002
SERVICE_APPOINTMENT_URL=http://appointment.internal.staging.his-hope.example:5003
SERVICE_CLINICAL_URL=http://clinical.internal.staging.his-hope.example:5004
SERVICE_LAB_URL=http://lab.internal.staging.his-hope.example:5010
SERVICE_BILLING_URL=http://billing.internal.staging.his-hope.example:5020
SERVICE_PHARMACY_URL=http://pharmacy.internal.staging.his-hope.example:5030
SERVICE_FHIR_GATEWAY_URL=http://fhir.internal.staging.his-hope.example:5040
SERVICE_DASHBOARD_BFF_URL=http://dashboard.internal.staging.his-hope.example:5600
SERVICE_DATABASE_CONTINUITY_URL=http://database-continuity.internal.staging.his-hope.example:5800
DATABASE_POSTGRES_URL=postgresql://his_hope_app@postgres.internal.staging.his-hope.example:5432/hishope
REDIS_URL=redis://redis.internal.staging.his-hope.example:6379
RABBITMQ_URL=amqp://his_hope_app@rabbitmq.internal.staging.his-hope.example:5672
RESILIENCE_HTTP_TIMEOUT_SECONDS=30
RESILIENCE_HTTP_RETRY_COUNT=3
OBSERVABILITY_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel.internal.staging.his-hope.example:4317

# Tenant selector migration: keep compatibility through the release cycle,
# then set to false after telemetry confirms zero legacy callers.
TENANT_CONTEXT_LEGACY_SELECTOR_ENABLED=true
TENANT_CONTEXT_LEGACY_SELECTOR_SUNSET=2026-12-31
OBSERVABILITY_PROMETHEUS_URL=http://prometheus.internal.staging.his-hope.example:9090
OBSERVABILITY_LOKI_URL=http://loki.internal.staging.his-hope.example:3100
OBSERVABILITY_ALERTMANAGER_URL=http://alertmanager.internal.staging.his-hope.example:9093
OBSERVABILITY_PROMETHEUS_REQUIRED=false
OBSERVABILITY_ELASTICSEARCH_URL=http://elasticsearch.internal.staging.his-hope.example:9200
OBSERVABILITY_ELASTICSEARCH_REQUIRED=false
OBSERVABILITY_JAEGER_URL=http://jaeger.internal.staging.his-hope.example:16686
OBSERVABILITY_JAEGER_REQUIRED=false
SECRET_POSTGRES_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_POSTGRES_PASSWORD_REF=kv/data/his-hope/staging/postgres#password
SECRET_RABBITMQ_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_RABBITMQ_PASSWORD_REF=kv/data/his-hope/staging/rabbitmq#password
SECRET_REDIS_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_REDIS_PASSWORD_REF=kv/data/his-hope/staging/redis#password
SECRET_OIDC_CLIENT_SECRET=__FROM_SECRET_PROVIDER__
SECRET_OIDC_CLIENT_SECRET_REF=kv/data/his-hope/staging/oidc#client-secret
DEVICE_POSTURE_MODE=stepup
DEVICE_POSTURE_PROVIDERS=chrome-enterprise,advanced-compliance,windows-local-login,play-integrity,app-attest
DEVICE_POSTURE_TTL_SECONDS=900
DEVICE_POSTURE_REQUIRED_SIGNALS=device_secure,not_rooted
DEVICE_POSTURE_ENFORCE_CLINICAL=true
PASSWORD_HISTORY_ENABLED=true
PASSWORD_HISTORY_COUNT=5
IDENTITY_RETENTION_COMPLETED_OUTBOX_DAYS=7
IDENTITY_RETENTION_TELEMETRY_DAYS=30
IDENTITY_RETENTION_SECURITY_EVENT_DAYS=90
IDENTITY_RETENTION_DEVICE_POSTURE_DAYS=7
IDENTITY_RETENTION_PROCESSED_PUSH_DAYS=7
IDENTITY_RETENTION_BATCH_SIZE=500
IDENTITY_RETENTION_INTERVAL_MINUTES=30
IDENTITY_RETENTION_LOCK_TTL_MINUTES=10
AUDIT_APPEND_ONLY=true
AUDIT_REDACTION_ENABLED=true
EXTERNAL_FEDERATION_ENABLED=false
SCIM_M2M_ENABLED=true
AUTHZ_PDP_MODE=canary
OPENFGA_API_URL=http://openfga.internal.staging.his-hope.example:8080
AUTHZ_OPENFGA_URL=http://openfga.internal.staging.his-hope.example:8080
AUTHZ_OPENFGA_STORE_ID=his-hope-staging
AUTHZ_OPENFGA_MODEL_ID=latest
AUDIT_SIEM_URL=https://siem.staging.his-hope.example/api/events
AUDIT_WORM_ENDPOINT=https://worm.staging.his-hope.example
AUDIT_WORM_BUCKET=his-hope-identity-audit
AUDIT_WORM_RETENTION_DAYS=2555
AUDIT_WORM_EVIDENCE_URI=https://evidence.staging.his-hope.example/siem-worm/latest
FAPI_CONFORMANCE_PROFILE=FAPI2_SECURITY
FAPI_CONFORMANCE_ISSUER=https://identity.staging.his-hope.example
FAPI_CONFORMANCE_REPORT_URI=https://evidence.staging.his-hope.example/fapi/latest
FAPI_CONFORMANCE_TEST_CLIENT_ID=regulated-partner-staging
FAPI_CONFORMANCE_SECRET_REF=kv/data/his-hope/staging/fapi-test-client
LEGACY_AUTH_SUNSET=Sat, 01 Jan 2028 00:00:00 GMT
PROVISIONING_MODE=dry-run
PROVISIONING_TARGETS=scim,entra,google-workspace
SSF_ENABLED=false
MTLS_ENABLED=false
RADIUS_EAP_TLS_ENABLED=false
CSV_EXPORT_ENABLED=true
PROVISIONING_SCIM_BASE_URL=
PROVISIONING_SCIM_TOKEN_URL=
PROVISIONING_SCIM_CLIENT_ID=
PROVISIONING_SCIM_SCOPE=scim.write
PROVISIONING_ENTRA_ENABLED=false
PROVISIONING_ENTRA_BASE_URL=https://graph.microsoft.com/v1.0
PROVISIONING_ENTRA_TOKEN_URL=
PROVISIONING_ENTRA_CLIENT_ID=
PROVISIONING_ENTRA_SCOPE=https://graph.microsoft.com/.default
ENTRA_AUTHORITY=
ENTRA_CLIENT_ID=__FROM_SECRET_PROVIDER__
ENTRA_CLIENT_SECRET=__FROM_SECRET_PROVIDER__
EXTERNAL_SOURCE_0_NAME=
EXTERNAL_SOURCE_0_DISPLAY_NAME=
EXTERNAL_SOURCE_0_AUTHORITY=
EXTERNAL_SOURCE_0_CLIENT_ID=__FROM_SECRET_PROVIDER__
EXTERNAL_SOURCE_0_CLIENT_SECRET=__FROM_SECRET_PROVIDER__
PROVISIONING_GOOGLE_WORKSPACE_ENABLED=false
PROVISIONING_GOOGLE_WORKSPACE_BASE_URL=https://admin.googleapis.com/admin/directory/v1
PROVISIONING_GOOGLE_WORKSPACE_TOKEN_URL=https://oauth2.googleapis.com/token
PROVISIONING_GOOGLE_WORKSPACE_SECRET_ID=google-workspace-service-account
PROVISIONING_GOOGLE_WORKSPACE_DELEGATED_ADMIN=
SSF_RECEIVER_URL=
SSF_RECEIVER_AUDIENCE=
MTLS_TRUSTED_CA_FILE=/etc/hishop/certs/client-ca.pem
