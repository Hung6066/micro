# Azure staging — conglomerate Identity Phase 0
# Copy to a secure path (e.g. D:\secure\his-hope\azure-staging.env) and fill from Deploy-Phase0 outputs.

HIS_HOPE_ENVIRONMENT=azure-staging
HIS_HOPE_RUNTIME_CONTRACT_VERSION=v1
HIS_HOPE_PUBLIC_API_ORIGIN=https://api.staging.abc-group.example
HIS_HOPE_PUBLIC_WEB_ORIGIN=https://manufacturing.staging.abc-group.example
HIS_HOPE_PUBLIC_ADMIN_ORIGIN=https://admin.staging.abc-group.example
HIS_HOPE_PUBLIC_DASHBOARD_ORIGIN=https://ops.staging.abc-group.example
HIS_HOPE_OIDC_AUTHORITY=https://identity.staging.abc-group.example
HIS_HOPE_SECRET_PROVIDER=azure-keyvault
HIS_HOPE_SECRET_PROVIDER_REF=https://<key-vault-name>.vault.azure.net/secrets/his-hope-azure-staging-runtime

# Azure Phase 0 infrastructure (from artifacts/azure/phase0-deployment.json)
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=rg-hishop-azure-staging
AZURE_LOCATION=southeastasia
AZURE_KEY_VAULT_NAME=<key-vault-name>
AZURE_ACR_LOGIN_SERVER=<prefix>acr.azurecr.io
AZURE_ACR_NAME=<prefix>acr
AZURE_BACKUP_STORAGE_ACCOUNT=<storage-account-name>

# Data plane
DATABASE_POSTGRES_HOST=<postgres-fqdn>
DATABASE_POSTGRES_PORT=5432
DATABASE_POSTGRES_DATABASE=identitydb
DATABASE_POSTGRES_USER=hishop_admin
DATABASE_POSTGRES_URL=postgresql://hishop_admin@<postgres-fqdn>:5432/identitydb
REDIS_HOST=<redis-hostname>
REDIS_PORT=6380
REDIS_URL=rediss://:<password>@<redis-hostname>:6380

# Identity runtime
SERVICE_IDENTITY_URL=https://identity.staging.abc-group.example
ASPNETCORE_ENVIRONMENT=Azure.Staging
PERSISTENCE_RUN_MIGRATIONS_ON_STARTUP=true
CONGLOMERATE_ENABLED=true
CONGLOMERATE_SKIP_DEMO_HOSPITAL_SCOPE=true

# Secrets — reference Key Vault; never store plaintext in repo
SECRET_POSTGRES_PASSWORD=__FROM_KEY_VAULT__
SECRET_POSTGRES_PASSWORD_REF=his-hope/postgres-admin-password
SECRET_REDIS_PASSWORD=__FROM_KEY_VAULT__
SECRET_REDIS_PASSWORD_REF=his-hope/redis-primary-key
SECRET_JWT_SIGNING_KEY=__FROM_KEY_VAULT__
SECRET_JWT_SIGNING_KEY_REF=his-hope/jwt-signing-key

# Security posture (aligned with staging contract)
DEVICE_POSTURE_MODE=stepup
AUTHZ_PDP_MODE=canary
OPENFGA_API_URL=http://openfga.internal.staging.abc-group.example:8080
ASSURANCE_POLICY_PATH=config/assurance-policy.v1.json
AUDIT_APPEND_ONLY=true
AUDIT_SIEM_URL=
AUDIT_WORM_ENDPOINT=
LEGACY_AUTH_SUNSET=Sat, 01 Jan 2028 00:00:00 GMT
