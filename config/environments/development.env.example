HIS_HOPE_ENVIRONMENT=development
HIS_HOPE_RUNTIME_CONTRACT_VERSION=v1
HIS_HOPE_PUBLIC_API_ORIGIN=http://localhost:5000
HIS_HOPE_PUBLIC_WEB_ORIGIN=http://localhost:4200
HIS_HOPE_PUBLIC_ADMIN_ORIGIN=http://localhost:4201
HIS_HOPE_PUBLIC_DASHBOARD_ORIGIN=http://localhost:4202
HIS_HOPE_OIDC_AUTHORITY=http://localhost:5001
HIS_HOPE_SECRET_PROVIDER=vault
HIS_HOPE_SECRET_PROVIDER_REF=kv/data/his-hope/development/runtime
SERVICE_API_GATEWAY_URL=http://api-gateway:5000
SERVICE_IDENTITY_URL=http://identityservice:5001
SERVICE_PATIENT_URL=http://patientservice:5002
SERVICE_APPOINTMENT_URL=http://appointmentservice:5003
SERVICE_CLINICAL_URL=http://clinicalservice:5004
SERVICE_LAB_URL=http://labservice:5010
SERVICE_BILLING_URL=http://billingservice:5020
SERVICE_PHARMACY_URL=http://pharmacyservice:5030
SERVICE_DASHBOARD_BFF_URL=http://systemdashboard-bff:5700
SERVICE_DATABASE_CONTINUITY_URL=http://database-continuity-service:5800
DATABASE_POSTGRES_URL=postgresql://his_hope_app@postgres:5432/hishope
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://his_hope_app@rabbitmq:5672
RESILIENCE_HTTP_TIMEOUT_SECONDS=30
RESILIENCE_HTTP_RETRY_COUNT=3
OBSERVABILITY_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OBSERVABILITY_PROMETHEUS_URL=http://prometheus:9090
OBSERVABILITY_LOKI_URL=http://loki:3100
OBSERVABILITY_ALERTMANAGER_URL=http://alertmanager:9093
OBSERVABILITY_PROMETHEUS_REQUIRED=false
OBSERVABILITY_ELASTICSEARCH_URL=http://elasticsearch:9200
OBSERVABILITY_ELASTICSEARCH_REQUIRED=false
OBSERVABILITY_JAEGER_URL=http://jaeger:16686
OBSERVABILITY_JAEGER_REQUIRED=false
SECRET_POSTGRES_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_POSTGRES_PASSWORD_REF=kv/data/his-hope/development/postgres#password
SECRET_RABBITMQ_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_RABBITMQ_PASSWORD_REF=kv/data/his-hope/development/rabbitmq#password
SECRET_REDIS_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_REDIS_PASSWORD_REF=kv/data/his-hope/development/redis#password
SECRET_OIDC_CLIENT_SECRET=__FROM_SECRET_PROVIDER__
SECRET_OIDC_CLIENT_SECRET_REF=kv/data/his-hope/development/oidc#client-secret
