HIS_HOPE_ENVIRONMENT=production
HIS_HOPE_RUNTIME_CONTRACT_VERSION=v1
HIS_HOPE_PUBLIC_API_ORIGIN=https://api.his-hope.example
HIS_HOPE_PUBLIC_WEB_ORIGIN=https://app.his-hope.example
HIS_HOPE_PUBLIC_ADMIN_ORIGIN=https://admin.his-hope.example
HIS_HOPE_PUBLIC_DASHBOARD_ORIGIN=https://ops.his-hope.example
HIS_HOPE_OIDC_AUTHORITY=https://identity.his-hope.example
HIS_HOPE_SECRET_PROVIDER=vault
HIS_HOPE_SECRET_PROVIDER_REF=kv/data/his-hope/production/runtime
IDENTITY_BOOTSTRAP_ADMIN_RESET_PASSWORD=false
SERVICE_API_GATEWAY_URL=http://api-gateway.his-hope.svc.cluster.local:5000
SERVICE_IDENTITY_URL=http://identity-service.his-hope.svc.cluster.local:5003
CORS__ALLOWEDORIGINS__0=https://app.his-hope.vn
CORS__ALLOWEDORIGINS__1=https://dashboard.his-hope.vn
CORS__ALLOWEDORIGINS__2=https://admin.his-hope.vn
RATELIMITING__TRUSTFORWARDEDKEY=false
SERVICE_PATIENT_URL=http://patient-service.his-hope.svc.cluster.local:5002
SERVICE_APPOINTMENT_URL=http://appointment-service.his-hope.svc.cluster.local:5004
SERVICE_CLINICAL_URL=http://clinical-service.his-hope.svc.cluster.local:5005
SERVICE_LAB_URL=http://lab-service.his-hope.svc.cluster.local:5010
SERVICE_BILLING_URL=http://billing-service.his-hope.svc.cluster.local:5020
SERVICE_PHARMACY_URL=http://pharmacy-service.his-hope.svc.cluster.local:5030
SERVICE_FHIR_GATEWAY_URL=http://fhir-gateway.his-hope.svc.cluster.local:5040
SERVICE_DASHBOARD_BFF_URL=http://dashboard-bff.his-hope.svc.cluster.local:5600
SERVICE_DATABASE_CONTINUITY_URL=http://database-continuity.his-hope.svc.cluster.local:5800
DATABASE_POSTGRES_URL=postgresql://his_hope_app@postgres.his-hope.svc.cluster.local:5432/hishope
REDIS_URL=redis://redis.his-hope.svc.cluster.local:6379
RABBITMQ_URL=amqp://his_hope_app@rabbitmq.his-hope.svc.cluster.local:5672
RESILIENCE_HTTP_TIMEOUT_SECONDS=30
RESILIENCE_HTTP_RETRY_COUNT=3
OBSERVABILITY_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.his-hope.svc.cluster.local:4317
OBSERVABILITY_PROMETHEUS_URL=http://prometheus.his-hope.svc.cluster.local:9090
OBSERVABILITY_LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
OBSERVABILITY_ALERTMANAGER_URL=http://alertmanager.monitoring.svc.cluster.local:9093
OBSERVABILITY_PROMETHEUS_REQUIRED=false
OBSERVABILITY_ELASTICSEARCH_URL=http://elasticsearch.his-hope.svc.cluster.local:9200
OBSERVABILITY_ELASTICSEARCH_REQUIRED=false
OBSERVABILITY_JAEGER_URL=http://jaeger.his-hope.svc.cluster.local:16686
OBSERVABILITY_JAEGER_REQUIRED=false
SECRET_POSTGRES_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_POSTGRES_PASSWORD_REF=kv/data/his-hope/production/postgres#password
SECRET_RABBITMQ_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_RABBITMQ_PASSWORD_REF=kv/data/his-hope/production/rabbitmq#password
SECRET_REDIS_PASSWORD=__FROM_SECRET_PROVIDER__
SECRET_REDIS_PASSWORD_REF=kv/data/his-hope/production/redis#password
SECRET_OIDC_CLIENT_SECRET=__FROM_SECRET_PROVIDER__
SECRET_OIDC_CLIENT_SECRET_REF=kv/data/his-hope/production/oidc#client-secret
DEVICE_POSTURE_MODE=observe
DEVICE_POSTURE_PROVIDERS=chrome-enterprise,advanced-compliance,windows-local-login
DEVICE_POSTURE_TTL_SECONDS=900
DEVICE_POSTURE_REQUIRED_SIGNALS=
DEVICE_POSTURE_ENFORCE_CLINICAL=false
PASSWORD_HISTORY_ENABLED=true
PASSWORD_HISTORY_COUNT=5
AUDIT_APPEND_ONLY=true
AUDIT_REDACTION_ENABLED=true
EXTERNAL_FEDERATION_ENABLED=false
SCIM_M2M_ENABLED=true
AUTHZ_PDP_MODE=disabled
PROVISIONING_MODE=dry-run
PROVISIONING_TARGETS=scim,entra,google-workspace
SSF_ENABLED=false
MTLS_ENABLED=false
RADIUS_EAP_TLS_ENABLED=false
CSV_EXPORT_ENABLED=true
PROVISIONING_SCIM_BASE_URL=
PROVISIONING_SCIM_TOKEN_URL=
PROVISIONING_SCIM_CLIENT_ID=
PROVISIONING_SCIM_SCOPE=scim.write
PROVISIONING_ENTRA_ENABLED=false
PROVISIONING_ENTRA_BASE_URL=https://graph.microsoft.com/v1.0
PROVISIONING_ENTRA_TOKEN_URL=
PROVISIONING_ENTRA_CLIENT_ID=
PROVISIONING_ENTRA_SCOPE=https://graph.microsoft.com/.default
ENTRA_AUTHORITY=
ENTRA_CLIENT_ID=__FROM_SECRET_PROVIDER__
ENTRA_CLIENT_SECRET=__FROM_SECRET_PROVIDER__
EXTERNAL_SOURCE_0_NAME=
EXTERNAL_SOURCE_0_DISPLAY_NAME=
EXTERNAL_SOURCE_0_AUTHORITY=
EXTERNAL_SOURCE_0_CLIENT_ID=__FROM_SECRET_PROVIDER__
EXTERNAL_SOURCE_0_CLIENT_SECRET=__FROM_SECRET_PROVIDER__
PROVISIONING_GOOGLE_WORKSPACE_ENABLED=false
PROVISIONING_GOOGLE_WORKSPACE_BASE_URL=https://admin.googleapis.com/admin/directory/v1
PROVISIONING_GOOGLE_WORKSPACE_TOKEN_URL=https://oauth2.googleapis.com/token
PROVISIONING_GOOGLE_WORKSPACE_SECRET_ID=google-workspace-service-account
PROVISIONING_GOOGLE_WORKSPACE_DELEGATED_ADMIN=
SSF_RECEIVER_URL=
SSF_RECEIVER_AUDIENCE=
MTLS_TRUSTED_CA_FILE=/etc/hishop/certs/client-ca.pem
