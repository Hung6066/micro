{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://his-hope.example/schemas/runtime-contract.schema.json",
  "title": "His.Hope Runtime Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requiredKeys",
    "publicOrigins",
    "serviceEndpoints",
    "dataEndpoints",
    "resilience",
    "observability",
    "secretProvider",
    "secretReferences"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1"
    },
    "requiredKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      }
    },
    "publicOrigins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contractEndpoint"
      }
    },
    "serviceEndpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contractEndpoint"
      }
    },
    "dataEndpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contractEndpoint"
      }
    },
    "resilience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scalarSetting"
      }
    },
    "observability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/observabilityEndpoint"
          },
          {
            "$ref": "#/$defs/scalarSetting"
          }
        ]
      }
    },
    "secretProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerKey",
        "providerRefKey",
        "allowedProviders"
      ],
      "properties": {
        "providerKey": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "providerRefKey": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "allowedProviders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "secretReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secretKey",
          "secretRefKey",
          "requiredProviderRef"
        ],
        "properties": {
          "secretKey": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "secretRefKey": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "requiredProviderRef": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "contractEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "logicalName",
        "uriSchemes",
        "runtimes"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "public-origin",
            "service-url",
            "data-url",
            "observability-url",
            "oidc-authority"
          ]
        },
        "logicalName": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "uriSchemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "http",
              "https",
              "postgresql",
              "redis",
              "amqp"
            ]
          }
        },
        "strictRuntimeMatch": {
          "type": "boolean"
        },
        "allowLocalhostInProduction": {
          "type": "boolean"
        },
        "runtimes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "docker",
            "vm",
            "kubernetes"
          ],
          "properties": {
            "docker": {
              "$ref": "#/$defs/runtimeTarget"
            },
            "vm": {
              "$ref": "#/$defs/runtimeTarget"
            },
            "kubernetes": {
              "$ref": "#/$defs/runtimeTarget"
            }
          }
        }
      }
    },
    "runtimeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "observabilityEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "kind",
        "logicalName",
        "uriSchemes",
        "runtimes"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "type": {
          "type": "string",
          "const": "endpoint"
        },
        "kind": {
          "type": "string",
          "const": "observability-url"
        },
        "logicalName": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "uriSchemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "http",
              "https",
              "postgresql",
              "redis",
              "amqp"
            ]
          }
        },
        "strictRuntimeMatch": {
          "type": "boolean"
        },
        "allowLocalhostInProduction": {
          "type": "boolean"
        },
        "runtimes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "docker",
            "vm",
            "kubernetes"
          ],
          "properties": {
            "docker": {
              "$ref": "#/$defs/runtimeTarget"
            },
            "vm": {
              "$ref": "#/$defs/runtimeTarget"
            },
            "kubernetes": {
              "$ref": "#/$defs/runtimeTarget"
            }
          }
        }
      }
    },
    "scalarSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "integer",
            "boolean"
          ]
        },
        "minimum": {
          "type": "integer"
        }
      }
    }
  }
}
