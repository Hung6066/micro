# Copy to a local env file or pass with --env-file.
MANUFACTURING_POSTGRES_USER=manufacturing
MANUFACTURING_POSTGRES_PASSWORD=change-me
MANUFACTURING_RABBITMQ_USER=manufacturing
MANUFACTURING_RABBITMQ_PASSWORD=change-me
MANUFACTURING_API_PORT=5050
MANUFACTURING_POSTGRES_PORT=5435
MANUFACTURING_REDIS_PORT=6380
MANUFACTURING_RABBITMQ_PORT=5673
MANUFACTURING_RABBITMQ_MANAGEMENT_PORT=15673
MANUFACTURING_SEED_DEMO_DATA=true

# External OIDC authority; leave unset only for startup/migration checks.
MANUFACTURING_JWT_AUTHORITY=http://host.docker.internal:5001
MANUFACTURING_JWT_METADATA_ADDRESS=http://host.docker.internal:5001/.well-known/openid-configuration
MANUFACTURING_JWT_ISSUER=http://localhost:5000/
MANUFACTURING_JWT_AUDIENCE=http://localhost:5000/
